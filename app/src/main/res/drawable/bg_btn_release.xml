<?xml version="1.0" encoding="utf-8"?>
<selector android:shape="rectangle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape>
            <gradient android:startColor="#fffebb33" android:endColor="#ffff9204" android:angle="-90.0" />
            <corners android:radius="36.0dip" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#ff7f5d19" android:endColor="#ff7f4902" android:angle="-90.0" />
            <corners android:radius="36.0dip" />
        </shape>
    </item>
</selector>
