<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/dp_1" />
            <solid android:color="@android:color/darker_gray" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="@dimen/dp_1" />
                <gradient android:startColor="@color/color_80ffd300" android:endColor="@color/color_a0ffcb00" android:angle="270.0" android:centerY="0.75" android:centerColor="@color/color_80ffb600" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/dp_1" />
                <solid android:color="@android:color/holo_orange_dark" />
            </shape>
        </clip>
    </item>
</layer-list>
